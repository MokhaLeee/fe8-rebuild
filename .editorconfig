root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 8
tab_width = 8

# C 源码：内核风格，Tab 缩进
[*.{c,h}]
indent_style = tab
indent_size = 8

# 汇编与 inc：保持原样，多数是数据表
[*.{s,S,inc}]
indent_style = tab
indent_size = 8
trim_trailing_whitespace = false

# Makefile 必须用 Tab
[Makefile]
indent_style = tab
[{*.mk,*.mk.in}]
indent_style = tab

# 文档与配置：空格缩进
[*.{md,markdown,yml,yaml,json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{py,sh}]
indent_style = space
indent_size = 4
